# APP-04 ConseilDesk - Elastic Beanstalk (plateforme PHP sur AL2023).
# MINIMAL & SUR : UNIQUEMENT des variables d'environnement (namespace toujours valide).
# Le type d'instance, l'instance profile, single/ALB et HTTPS (certificat ACM) sont
# geres par la CLI `eb` / la console - on EVITE toute option depreciee ou `ProxyServer`
# (lecon AL2023 heritee d'APP-01..03). Aucun secret reel dans ce depot.
# Mode par defaut : AUTONOME (profil standalone, stockage SQLite local) - aucune base externe.
option_settings:
  aws:elasticbeanstalk:application:environment:
    APP_ENV: prod
    APP_DEBUG: "0"
    APP_PROFILE: standalone
    # Document root de la plateforme PHP (Apache + php-fpm) = public/
    # En profil `prod` reel avec RDS, fournir aussi :
    #   DB_URL: "mysql://user:pass@host:3306/conseildesk"   (RDS MySQL)
