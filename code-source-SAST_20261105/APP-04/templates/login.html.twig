{% include 'partials/header.html.twig' %}
<section class="card">
    <h1>Connexion ConseilDesk</h1>
    {% if error %}<p class="error">{{ error }}</p>{% endif %}
    <form method="post" action="/login" class="form">
        <input type="hidden" name="_token" value="{{ csrf }}">
        <label>Identifiant <input type="text" name="username" autocomplete="username"></label>
        <label>Mot de passe <input type="password" name="password" autocomplete="current-password"></label>
        <button type="submit">Se connecter</button>
    </form>
    <p class="hint">Comptes de demonstration : conseiller1 / conseiller2 / directeur1 (mot de passe Password1!).</p>
</section>
{% include 'partials/footer.html.twig' %}
