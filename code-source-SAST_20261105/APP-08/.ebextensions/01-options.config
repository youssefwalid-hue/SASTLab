# APP-08 CartaVie — Elastic Beanstalk (plateforme Ruby / Amazon Linux 2023).
# MINIMAL & SUR : UNIQUEMENT des variables d'environnement (namespace toujours valide
# sur AL2023). Le type d'instance, l'instance profile, single/ALB et HTTPS sont gérés
# par la CLI `eb` au déploiement — on évite ici toute option dépréciée ou de type
# ProxyServer (leçon AL2023).
#
# Profil AUTONOME : base SQLite embarquée (aucune base externe requise pour booter).
# Le Procfile lance : web: bundle exec puma -p 5000 (EB route 80/443 -> 5000).
option_settings:
  aws:elasticbeanstalk:application:environment:
    RAILS_ENV: production
    RACK_ENV: production
    RAILS_SERVE_STATIC_FILES: "true"
    RAILS_LOG_TO_STDOUT: "true"
    # EB Ruby lance `rake db:migrate` au déploiement : on le désactive car l'app amorce
    # son schéma SQLite elle-même (config/initializers/zz_bootstrap_db.rb) et il n'y a
    # aucune migration ; évite aussi tout accès DB pendant le staging (/var/app/current absent).
    RAILS_SKIP_MIGRATIONS: "true"
    PORT: "5000"
    # 
    # injecterait ici un SECRET_KEY_BASE robuste. Laissé faible volontairement.
    SECRET_KEY_BASE: "labsecret"
    CARTAVIE_DB_PATH: "/var/app/current/storage/production.sqlite3"
