<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <title>Widget carte <%= @card.id %> (lab)</title>
    <%# 
        en-tete anti-cadrage (ni X-Frame-Options, ni CSP frame-ancestors). La page
        peut etre encapsulee dans une <iframe> tierce et superposee. %>
    <style>body{font-family:system-ui,Arial,sans-serif;margin:0;padding:12px}
      .w{border:1px solid #ddd;border-radius:8px;padding:12px}</style>
  </head>
  <body>
    <div class="w">
      <h3>Carte <%= @card.id %> — <%= @card.label %></h3>
      <p>Statut : <%= @card.status %> · Disponible : <%= @card.available %> €</p>
      <%= form_with url: "/cards/#{@card.id}/toggle", method: :post, local: true do %>
        <%= submit_tag (@card.status == "active" ? "Mettre en opposition" : "Reactiver") %>
      <% end %>
    </div>
  </body>
</html>
