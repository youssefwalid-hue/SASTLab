# APP-02 Agréga Open — Elastic Beanstalk (plateforme Node.js, Amazon Linux 2023).
# MINIMAL & SÛR : UNIQUEMENT des variables d'environnement (namespace toujours valide).
# Le type d'instance, l'instance profile, single/ALB et HTTPS sont gérés par la CLI `eb`
# (évite les options invalides/dépréciées sur AL2023 — leçon APP-01).
# Mode par défaut : AUTONOME (profil standalone, stockage EN MÉMOIRE) — aucune base externe.
option_settings:
  aws:elasticbeanstalk:application:environment:
    APP_PROFILE: standalone
    NODE_ENV: production
    PORT: "5000"
    # En profil `prod` réel, fournir aussi :
    #   DB_URL: postgres://...   (PostgreSQL / RDS)
    #   REDIS_URL: redis://...   (Redis / ElastiCache)
