# =============================================================================
# APP-07 "PayGate XML" - Elastic Beanstalk (.NET sur Windows Server / IIS).
# MINIMAL & SUR : UNIQUEMENT des variables d'environnement (namespace toujours
# valide). Le type d'instance, l'instance profile, SingleInstance/ALB et HTTPS
# sont geres par la CLI `eb` (on EVITE toute option depreciee/ProxyServer -
# lecon AL2023/APP-01).
# Profil par defaut : AUTONOME (depot EN MEMOIRE) - aucune base externe requise.
# Banking DAST Benchmark Lab - DONNEES 100% FICTIVES - usage defensif.
# =============================================================================
option_settings:
  aws:elasticbeanstalk:application:environment:
    APP_PROFILE: standalone
    # Depot par defaut = memoire. Pour SQL Server LocalDB/RDS, basculer :
    #   DB_PROFILE: localdb
    #   DB_CONNSTRING: "Server=...;Database=PayGateLab;User Id=...;Password=..."
    DB_PROFILE: memory
    LAB_ENVIRONMENT: test-data-fictives
