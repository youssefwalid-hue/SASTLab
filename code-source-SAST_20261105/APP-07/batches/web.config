<?xml version="1.0" encoding="utf-8"?>
<!-- =========================================================================
     APP-07 "PayGate XML" - Configuration du dossier /batches/.
     renvoie la liste des fichiers de lot (ecart volontaire).
     Environnement de laboratoire - DONNEES 100% FICTIVES - usage defensif.
     ========================================================================= -->
<configuration>
  <system.webServer>
    <!-- ECART (V010) : listing de repertoire active. -->
    <directoryBrowse enabled="true" />
    <staticContent>
      <remove fileExtension=".xml" />
      <mimeMap fileExtension=".xml" mimeType="application/xml" />
    </staticContent>
  </system.webServer>
</configuration>
