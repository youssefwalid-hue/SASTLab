<?xml version="1.0" encoding="utf-8"?>
<!-- =========================================================================
     APP-07 "PayGate XML" - web.config (IIS / .NET Framework / WCF).
     Banking DAST Benchmark Lab - DONNEES 100% FICTIVES - usage defensif.
     SECURISE PAR DEFAUT ; les ecarts volontaires sont annotes GT: APP07-Vxxx.
     Rappels IIS (hors web.config) :
           volume (NtfsDisable8dot3NameCreation=0) -> enumeration via ~1/wildcard.
           Non parametrable dans web.config (reglage NTFS/IIS - voir SECURITY_MODEL).
     ========================================================================= -->
<configuration>

  <appSettings>
    <add key="APP_PROFILE" value="standalone" />
  </appSettings>

  <system.web>
    <!-- targetFramework 4.5 pour permettre la desactivation du MAC ViewState
         sur la page heritee (GT: APP07-V015). -->
    <!-- Modèle "Web Site" : le code (App_Code/) et les .svc/.aspx sont compilés par IIS au runtime
         (pas de build MSBuild). On référence explicitement les assemblys WCF/extensions nécessaires. -->
    <compilation debug="true" targetFramework="4.5">
      <assemblies>
        <add assembly="System.ServiceModel, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
        <add assembly="System.ServiceModel.Activation, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
        <add assembly="System.ServiceModel.Web, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
        <add assembly="System.Runtime.Serialization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
        <add assembly="System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
        <add assembly="System.Xml.Linq, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.5" enableVersionHeader="true" />

         et versions .NET sont divulguees. (Secur. : mode="RemoteOnly"/"On".) -->
    <customErrors mode="Off" />

         (Secur. : enableViewStateMac="true" + machineKey robuste et secret.) -->
    <pages enableViewStateMac="false" viewStateEncryptionMode="Never" />
  </system.web>

  <system.serviceModel>
    <behaviors>
      <serviceBehaviors>
        <behavior>
          <!-- WSDL/metadata expose (GET ?wsdl) - requis par le benchmark.
               CancelAllBatches (fuite de surface via le WSDL). -->
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="true" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true"
                               multipleSiteBindingsEnabled="true" />
    <bindings>
      <basicHttpBinding>
        <binding maxReceivedMessageSize="2097152">
          <!-- Binding SOAP 1.1 ; la lecture du corps brut (XXE/entites) est faite
               cote service via le Message WCF rebufferise (voir PaymentService.cs). -->
          <readerQuotas maxDepth="64" />
        </binding>
      </basicHttpBinding>
      <!-- TLS termine sur IIS (certificat autosigne) : un endpoint SOAP doit exister
           pour le schema https, sinon les POST en HTTPS repondent 404 (no endpoint). -->
      <basicHttpsBinding>
        <binding maxReceivedMessageSize="2097152">
          <readerQuotas maxDepth="64" />
          <security mode="Transport" />
        </binding>
      </basicHttpsBinding>
    </bindings>
    <!-- Mapping de protocole : https -> basicHttpsBinding (aucun mapping https par defaut). -->
    <protocolMapping>
      <add scheme="https" binding="basicHttpsBinding" />
    </protocolMapping>
  </system.serviceModel>

  <system.webServer>
    <!-- Modules : WebDAV laisse en place (voir requestFiltering). -->
    <modules runAllManagedModulesForAllRequests="true" />

         X-Frame-Options, CSP) n'est ajoute ici. (Secur. : emettre HSTS + en-tetes.)
         (X-AspNet-Version, X-Powered-By, Server restent exposes). -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Lab-Environment" value="test-data-fictives" />
        <!-- X-Powered-By laisse par defaut (divulgation V009). -->
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
             (OPTIONS/PROPFIND/PUT/MKCOL) passent. (Secur. : allowUnlisted="false".) -->
        <verbs allowUnlisted="true" />
        <requestLimits maxAllowedContentLength="2097152" />
      </requestFiltering>
    </security>

    <!-- Page d'accueil : la racine "/" sert index.html (bandeau de test, cohérence avec les
         autres applications du lab). Sans cela, IIS renvoie 403 (ni document par defaut, ni
         navigation de repertoire). Les guides/oracles ne sont PAS dans le bundle (anti-oracle),
         donc activer un document par defaut n'expose rien de sensible. -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Handlers managed : definis par <location path="..."> ci-dessous (un <add> global
         a chemin "receipts/download" est court-circuite par le handler de fichier statique
         car "receipts" est un repertoire reel). V009 n'a pas besoin de handler : WCF rend
         deja une erreur verbeuse sur /PaymentService.svc/err. -->
  </system.webServer>

  <!-- NC: APP07-N004 - l'endpoint d'administration INTERNE n'est pas accessible
       depuis l'exterieur : acces refuse a l'utilisateur anonyme. -->
  <location path="AdminService.svc">
    <system.web>
      <authorization>
        <deny users="?" />
      </authorization>
    </system.web>
  </location>

  <location path="legacy/Report.aspx">
    <system.web>
      <pages enableViewStateMac="false" viewStateEncryptionMode="Never" />
    </system.web>
  </location>

  <!-- Endpoints hors SOAP routes par chemin EXACT (path="*" dans le <location>). -->
  <location path="admin/reset">
    <system.webServer>
      <handlers>
        <add name="AdminReset" path="*" verb="POST"
             type="PayGate.Handlers.AdminResetHandler" resourceType="Unspecified" preCondition="integratedMode" />
      </handlers>
    </system.webServer>
  </location>
  <location path="receipts/download">
    <system.webServer>
      <handlers>
        <add name="ReceiptDownload" path="*" verb="GET"
             type="PayGate.Handlers.ReceiptDownloadHandler" resourceType="Unspecified" preCondition="integratedMode" />
      </handlers>
    </system.webServer>
  </location>
  <!-- NC: APP07-N007 - telechargement de releve CONFINE (ResolveStatementSecure). -->
  <location path="statements/download">
    <system.webServer>
      <handlers>
        <add name="StatementDownload" path="*" verb="GET"
             type="PayGate.Handlers.StatementDownloadHandler" resourceType="Unspecified" preCondition="integratedMode" />
      </handlers>
    </system.webServer>
  </location>

</configuration>
