# APP-05 CréditFlux — Elastic Beanstalk (plateforme Python, Amazon Linux 2023).
# MINIMAL & SÛR : UNIQUEMENT des variables d'environnement (namespace toujours
# valide). Le type d'instance, l'instance profile, single/ALB et HTTPS sont
# gérés par la CLI `eb` (évite les options invalides/dépréciées sur AL2023 —
# leçon APP-01 : aucune option dépréciée, pas de bloc ProxyServer ici).
# Profil AUTONOME : base SQLite locale, données 100 % fictives seedées au démarrage.
option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: creditflux.settings
    PYTHONUNBUFFERED: "1"
    # 
    DJANGO_DEBUG: "true"
    # Secrets de laboratoire (fictifs) — en prod réelle, injecter des valeurs sûres.
    DJANGO_SECRET_KEY: "lab-fictif-creditflux-app05"
    LAB_IMPORT_HMAC_KEY: "lab-hmac-key-app05-fictif"
    LAB_FETCH_ALLOWLIST: "creditflux.lab.exemple,media.creditflux.lab.exemple"
    # Le démarrage WSGI est fourni par le Procfile :
    #   web: gunicorn creditflux.wsgi --bind 0.0.0.0:5000
    # (aucune option de conteneur ici : UNIQUEMENT des variables d'environnement).
