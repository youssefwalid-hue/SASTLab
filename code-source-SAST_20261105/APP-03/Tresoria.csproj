<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    APP-03 "Tresoria" - Portail de tresorerie entreprises (DAST Benchmark Lab).
    Laboratoire DEFENSIF - DONNEES 100% FICTIVES - Securise par defaut.
    Les seules vulnerabilites presentes sont APP03-V001..V022 (ecarts localises).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Tresoria</AssemblyName>
    <RootNamespace>Tresoria</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.1.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.7.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
