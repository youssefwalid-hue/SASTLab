# APP-03 Tresoria - Elastic Beanstalk (plateforme .NET Core sur Linux).
# MINIMAL & SUR : UNIQUEMENT des variables d'environnement (namespace toujours valide).
# Le type d'instance, l'instance profile, single/ALB et HTTPS sont geres par la CLI `eb`
# (on EVITE les options invalides/depreciees sur AL2023 - lecon APP-01).
# Mode par defaut : AUTONOME (profil standalone, stockage EN MEMOIRE) - aucune base externe.
option_settings:
  aws:elasticbeanstalk:application:environment:
    APP_PROFILE: standalone
    ASPNETCORE_ENVIRONMENT: Production
    PORT: "5000"
    # En profil `prod` reel, fournir aussi :
    #   DB_URL: "Server=...;Database=tresoria;User Id=...;Password=..."  (SQL Server / RDS)
    #   REDIS_URL: "redis://..."                                          (Redis / ElastiCache)
