# APP-09 Novabourse — Elastic Beanstalk (plateforme Python, Amazon Linux 2023).
# MINIMAL & SUR : UNIQUEMENT des variables d'environnement (namespace toujours valide).
# Le type d'instance, l'instance profile, single/ALB et HTTPS sont geres par la CLI `eb`
# (evite les options invalides/depreciees sur AL2023 — lecon APP-01 : pas de ProxyServer).
# Mode par defaut : AUTONOME (profil standalone, stockage EN MEMOIRE + SQLite) — sans base externe.
option_settings:
  aws:elasticbeanstalk:application:environment:
    APP_PROFILE: standalone
    PORT: "5000"
    # OIDC / JWT de laboratoire (valeurs fictives ; surchargeables en prod) :
    OIDC_ISSUER: "https://novabourse.lab.exemple"
    OIDC_CLIENT_ID: "novabourse-spa"
    OIDC_AUDIENCE: "novabourse-api"
    SPA_ORIGIN: "https://novabourse.lab.exemple"
    # En profil `prod` reel, fournir aussi :
    #   DB_URL: postgres://...   (PostgreSQL / RDS)
    #   REDIS_URL: redis://...   (Redis / ElastiCache)
    #   LAB_JWT_SECRET: <secret injecte, hors depot>
