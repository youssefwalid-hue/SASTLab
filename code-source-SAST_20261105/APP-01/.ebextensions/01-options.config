# APP-01 Helios Banque — Elastic Beanstalk (Corretto 21 / Amazon Linux 2023).
# MINIMAL & SUR : uniquement des variables d'environnement (namespace toujours valide sur AL2023).
# Le type d'instance, l'instance profile, single/ALB et HTTPS sont gERES par la CLI eb dans
# 20-deploy-eb.sh (evite les options invalides/dEprEciEes sur AL2023).
# Mode par dEfaut : AUTONOME (profil ebstandalone, H2 embarquE) — aucune base externe.
option_settings:
  aws:elasticbeanstalk:application:environment:
    SPRING_PROFILES_ACTIVE: ebstandalone
    SERVER_PORT: "5000"
    HELIOS_STATEMENTS_DIR: /var/app/data/statements
