# APP-06 MobiPay - Elastic Beanstalk (plateforme Go sur Linux).
# MINIMAL & SUR : UNIQUEMENT des variables d'environnement (namespace toujours valide).
# Le type d'instance, l'instance profile, single/ALB et HTTPS sont geres par la CLI `eb`
# (on EVITE toute option invalide/depreciee sur AL2023 - lecon APP-01 : pas de ProxyServer,
# pas d'option de conteneur depreciee).
# Mode par defaut : AUTONOME (profil standalone, stockage EN MEMOIRE) - aucune base externe.
option_settings:
  aws:elasticbeanstalk:application:environment:
    APP_PROFILE: standalone
    PORT: "5000"
    # En profil `prod` reel, fournir aussi (non requis pour le lab autonome) :
    #   DB_URL: "postgres://user:pass@host:5432/mobipay"   (PostgreSQL / RDS)
    #   REDIS_URL: "redis://host:6379"                      (Redis / ElastiCache)
