# APP-10 OnboardR — Elastic Beanstalk (plateforme Docker, Amazon Linux 2023).
# MINIMAL & SUR : UNIQUEMENT des variables d'environnement (namespace toujours valide).
# Le type d'instance, l'instance profile, single/ALB et HTTPS (listener 443 + redirection 80)
# sont geres par la CLI `eb` / la console — PAS ici — afin d'eviter les options invalides ou
# depreciees sur AL2023 (aucune option `ProxyServer`, aucune option heritee AL2).
# L'orchestration multi-conteneurs est assuree par docker-compose.yml, lu nativement par la
# plateforme Docker AL2023.
option_settings:
  aws:elasticbeanstalk:application:environment:
    # Secrets de LABORATOIRE (donnees fictives). A surcharger par des valeurs propres a
    # l'environnement si besoin ; partages entre les deux microservices.
    SESSION_SECRET: "lab-onboardr-session-secret-fictif"
    GATEWAY_SECRET: "lab-gw-6f2c1e9a-NON-DEVINABLE"
